# Copy to .env (git-ignored) and adjust. Read by `docker compose`.

# Must match the host user that owns ./data so the containers can write the database (`id -u`, `id -g`).
# Changing these needs a rebuild: docker compose build
CAT_UID=1000
CAT_GID=1000

# Timezone for log timestamps and the website's real-time labels.
TZ=America/Denver

# Host port for the public website (the container always listens on 8080).
WEB_PORT=8080

# Ollama image tag. "latest" is convenient; pin a version once you have a setup you like.
OLLAMA_TAG=latest
